{
  "expo": {
    "name": "dog-schedule",
    "slug": "dog-schedule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dogschedule",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIStatusBarHidden": true
      },
      "bundleIdentifier": "com.manoshatzi.dog-schedule",
      "usesAppleSignIn": true,
      "appleTeamId": "ANAGV4K9XD"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6B4F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.manoshatzi.dogschedule"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6B4F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1F4A36",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#2F6B4F",
          "defaultChannel": "activity"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f0b252ed-e54b-469f-9e31-4f00249b7205"
      }
    },
    "owner": "manoshatzi"
  }
}
